<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Members only</title>
    <script defer src="/js/profile.js"></script>
    <link rel="stylesheet" href="/styles/profile.css" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Arimo:wght@400..700&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap");
    </style>
  </head>
  <body>
    <div class="header-wrapper">
      <header>
        <nav>
          <h1><a href="/">Members Only Club</a></h1>
          <div class="link-container">
            <a href="/">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                <path
                  d="M576 304C576 436.5 461.4 544 320 544C282.9 544 247.7 536.6 215.9 523.3L97.5 574.1C88.1 578.1 77.3 575.8 70.4 568.3C63.5 560.8 62 549.8 66.8 540.8L115.6 448.6C83.2 408.3 64 358.3 64 304C64 171.5 178.6 64 320 64C461.4 64 576 171.5 576 304z"
                />
              </svg>
            </a>
            <form method="post" action="/logout">
              <button type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                  <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                  <path
                    d="M352 64C352 46.3 337.7 32 320 32C302.3 32 288 46.3 288 64L288 320C288 337.7 302.3 352 320 352C337.7 352 352 337.7 352 320L352 64zM210.3 162.4C224.8 152.3 228.3 132.3 218.2 117.8C208.1 103.3 188.1 99.8 173.6 109.9C107.4 156.1 64 233 64 320C64 461.4 178.6 576 320 576C461.4 576 576 461.4 576 320C576 233 532.6 156.1 466.3 109.9C451.8 99.8 431.9 103.3 421.7 117.8C411.5 132.3 415.1 152.2 429.6 162.4C479.4 197.2 511.9 254.8 511.9 320C511.9 426 425.9 512 319.9 512C213.9 512 128 426 128 320C128 254.8 160.5 197.1 210.3 162.4z"
                  />
                </svg>
              </button>
            </form>
          </div>
        </nav>
      </header>
    </div>
    <div class="main-wrapper">
      <h1>Profile</h1>
      <main>
        <div class="form-container">
          <h2>Become a Member</h2>
          <% if(!locals.profileAccess?.member){%>
          <form action="/profile/member/status" method="post">
            <% if(locals.memberErrors){%> <%- include("partials/errors.ejs")%>
            <%}%>

            <label for="memberPassword"
              ><p>(Hint: It's "a secret")</p>
              Password
              <input type="password" id="memberPassword" name="password"
            /></label>
            <button type="submit">Submit</button>
          </form>
          <%}%>
          <% if(locals.profileAccess?.member){%>
          <div
            class="member-toggle-container"
            data-status="<%= locals.memberStatus ? 'true' : 'false' %>"
          >
            <p class="status-message"></p>
            <div class="error-container"></div>
            <label></label>
            <input type="checkbox" name="memberToggle" class="member-toggle" />
            <span class="slider"></span>
          </div>
          <%}%>
        </div>
        <div class="form-container">
          <h2>Become an Admin</h2>
          <% if(!locals.profileAccess?.admin){%>
          <form action="/profile/admin/status" method="post">
            <% if(locals.adminErrors){%> <%- include("partials/errors.ejs")%>
            <%}%>
            <label for="adminPassword"
              >Password
              <input type="password" id="adminPassword" name="password"
            /></label>

            <button type="submit">Submit</button>
          </form>
          <%}%>
          <% if(locals.profileAccess?.admin){%>
          <div
            class="admin-toggle-container"
            data-status="<%= locals.adminStatus ? 'true' : 'false' %>"
          >
            <p class="status-message"></p>
            <div class="error-container"></div>
            <label></label>
            <input type="checkbox" name="adminToggle" class="admin-toggle" />
            <span class="slider"></span>
          </div>
          <%}%>
        </div>
      </main>
    </div>
    <div class="footer-wrapper"><%- include("partials/footer") %></div>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Membery only</title>
    <link rel="stylesheet" href="/styles/login.css" />
  </head>
  <body>
    <div class="header-wrapper">
      <header>
        <nav>
          <h1><a href="/">Members Only Club</a></h1>
          <div class="link-container">
            <a href="/">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                <path
                  d="M576 304C576 436.5 461.4 544 320 544C282.9 544 247.7 536.6 215.9 523.3L97.5 574.1C88.1 578.1 77.3 575.8 70.4 568.3C63.5 560.8 62 549.8 66.8 540.8L115.6 448.6C83.2 408.3 64 358.3 64 304C64 171.5 178.6 64 320 64C461.4 64 576 171.5 576 304z"
                />
              </svg>
            </a>
          </div>
        </nav>
      </header>
    </div>
    <div class="main-wrapper">
      <main>
        <form method="post" action="/sign-up">
          <h1>Sign Up</h1>
          <%- include("partials/errors.ejs") %>
          <%if(locals.failedUserCreation){%>
          <p>We couldn't sign you up right now, please try again later.</p>
          <%}%>
          <label for="firstname"
            >Firstname <input type="text" name="firstname" id="firstname"
          /></label>
          <label for="lastname"
            >Lastname <input type="text" name="lastname" id="lastname"
          /></label>
          <label for="username"
            >Username
            <input type="text" name="username" id="username" autocomplete="off"
          /></label>
          <label for="password"
            >Password <input type="password" name="password" id="password"
          /></label>
          <label for="passwordConfirmation"
            >Confirm Password
            <input
              type="password"
              name="passwordConfirmation"
              id="passwordConfirmation"
          /></label>
          <button type="submit">Sign Up</button>
        </form>
        <p>Already have an account? <a href="/login">Log in</a></p>
      </main>
    </div>
    <div class="footer-wrapper"><%- include("partials/footer") %></div>
  </body>
</html>

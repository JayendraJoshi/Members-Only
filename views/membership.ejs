<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Members only</title>
    <script defer src="/js/membership.js"></script>
    <link rel="stylesheet" href="/styles/profile.css" />
  </head>
  <body>
    <div class="header-wrapper">
      <header>
        <nav>
          <h1>Members Only Club</h1>
          <div class="link-container">
            <a href="/"><img src="/icons/messages.svg" /></a>
            <form method="post" action="/logout">
              <button type="submit"><img src="/icons/logout.svg" /></button>
            </form>
          </div>
        </nav>
      </header>
    </div>
    <div class="main-wrapper">
      <main>
        <div class="form-container">
          <h2>Manage member status</h2>
          <% if(!locals.membershipAccess?.member){%>
          <form action="/membership/member/status" method="post">
            <% if(locals.memberErrors){%> <%- include("partials/errors.ejs")%>
            <%}%>

            <label for="memberPassword"
              ><p>(Hint: It's "a secret")</p>
              Password
              <input type="password" id="memberPassword" name="password"
            /></label>
            <button type="submit">Submit</button>
          </form>
          <%}%>
          <% if(locals.membershipAccess?.member){%>
          <div
            class="member-toggle-container"
            data-status="<%= locals.memberStatus ? 'true' : 'false' %>"
          >
            <p class="status-message"></p>
            <div class="error-container"></div>
            <label class="toggle"></label>
            <input type="checkbox" name="memberToggle" class="member-toggle" />
            <span class="slider"></span>
          </div>
          <%}%>
        </div>
        <div class="form-container">
          <h2>Manage admin status</h2>
          <% if(!locals.membershipAccess?.admin){%>
          <form action="/membership/admin/status" method="post">
            <% if(locals.adminErrors){%> <%- include("partials/errors.ejs")%>
            <%}%>
            <label for="adminPassword"
              >Password
              <input type="password" id="adminPassword" name="password"
            /></label>

            <button type="submit">Submit</button>
          </form>
          <%}%>
          <% if(locals.membershipAccess?.admin){%>
          <div
            class="admin-toggle-container"
            data-status="<%= locals.adminStatus ? 'true' : 'false' %>"
          >
            <p class="status-message"></p>
            <div class="error-container"></div>
            <label class="toggle"></label>
            <input type="checkbox" name="adminToggle" class="admin-toggle" />
            <span class="slider"></span>
          </div>
          <%}%>
        </div>
      </main>
    </div>
    <div class="footer-wrapper"><%- include("partials/footer") %></div>
  </body>
</html>

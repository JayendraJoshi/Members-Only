<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Members Only</title>
    <script defer src="/js/message-dialog.js"></script>
    <link rel="stylesheet" href="/styles/index.css" />
  </head>
  <body>
    <div class="header-wrapper">
      <header>
        <nav>
          <h1>Members Only Club</h1>
          <div class="link-container">
            <% if(!locals.currentUser){ %>
            <a href="/login"><img src="/icons/login.svg" /></a>
            <%}else{%>
            <a href="/"></a>
            <a href="/membership"
              ><img src="/icons/profile.svg" alt="Profile"
            /></a>
            <form method="post" action="/logout">
              <button type="submit"><img src="/icons/logout.svg" /></button>
            </form>
            <%}%>
          </div>
        </nav>
      </header>
    </div>
    <div class="main-wrapper">
      <main>
        <h1>Messages</h1>
        <% if(locals.currentUser){ %>
        <form class="open-message-dialog">
          <p class="server-error"></p>
          <button type="button">
            <img src="/icons/add.svg" />
          </button>
        </form>
        <% }%>
        <div class="messages-container">
          <% if(locals.failedFetch){%>
          <p>
            We couldn't load the messages right now, please try again later.
          </p>
          <%}%>
          <% if(locals.messages){%>
          <% messages.forEach(message=>{%>
          <div class="message-card">
            <%if (locals.failedDeletion && locals.failedDeleteMessageId ===
            message.id){%>
            <p>
              We couldn't delete the message right now, please try again later.
            </p>
            <%}%>
            <%if(locals.currentUser?.ismember){%>
            <div class="message-data-container">
              <p>Username</p>
              <%= locals.currentUser.username %>
            </div>
            <div class="message-data-container">
              <p>Timestamp</p>
              <p><%= message.timestamp %></p>
            </div>
            <%}%>
            <div class="message-data-container">
              <p>Title</p>
              <p><%= message.title %></p>
            </div>
            <div class="message-data-container">
              <p>Text</p>
              <p><%= message.text %></p>
            </div>

            <% if(locals.currentUser?.isadmin){%>
            <div class="message-data-container">
              <form action="/message/delete/<%= message.id %>" method="post">
                <button type="submit">Delete</button>
              </form>
            </div>
            <%}%>
          </div>
          <%})%>
          <%}%>
        </div>
        <dialog>
          <form class="message-form" method="post" action="/">
            <h3>Add message</h3>
            <div class="error-container"></div>
            <label for="title">Title<input id="title" name="title" /></label>
            <label for="text">Text<input id="text" name="text" /></label>
            <div class="button-container">
              <button class="cancel-button" type="button">Cancel</button>
              <button class="add-button" type="submit">Add</button>
            </div>
          </form>
        </dialog>
      </main>
    </div>
    <div class="footer-wrapper"><%- include("partials/footer") %></div>
  </body>
</html>

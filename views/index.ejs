<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Members Only</title>
    <script defer src="/js/message-dialog.js"></script>
    <link rel="stylesheet" href="/styles/index.css" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Arimo:wght@400..700&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap");
    </style>
  </head>
  <body>
    <div class="header-wrapper">
      <header>
        <nav>
          <h1><a href="/">Members Only Club</a></h1>
          <div class="link-container">
            <% if(!locals.currentUser){ %>
            <a href="/login"
              ><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                <path
                  d="M409 337C418.4 327.6 418.4 312.4 409 303.1L265 159C258.1 152.1 247.8 150.1 238.8 153.8C229.8 157.5 224 166.3 224 176L224 256L112 256C85.5 256 64 277.5 64 304L64 336C64 362.5 85.5 384 112 384L224 384L224 464C224 473.7 229.8 482.5 238.8 486.2C247.8 489.9 258.1 487.9 265 481L409 337zM416 480C398.3 480 384 494.3 384 512C384 529.7 398.3 544 416 544L480 544C533 544 576 501 576 448L576 192C576 139 533 96 480 96L416 96C398.3 96 384 110.3 384 128C384 145.7 398.3 160 416 160L480 160C497.7 160 512 174.3 512 192L512 448C512 465.7 497.7 480 480 480L416 480z"
                />
              </svg>
            </a>
            <%}else{%>
            <a href="/"></a>
            <a href="/profile"
              ><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                <path
                  d="M463 448.2C440.9 409.8 399.4 384 352 384L288 384C240.6 384 199.1 409.8 177 448.2C212.2 487.4 263.2 512 320 512C376.8 512 427.8 487.3 463 448.2zM64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576C178.6 576 64 461.4 64 320zM320 336C359.8 336 392 303.8 392 264C392 224.2 359.8 192 320 192C280.2 192 248 224.2 248 264C248 303.8 280.2 336 320 336z"
                />
              </svg>
            </a>
            <form method="post" action="/logout">
              <button type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                  <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                  <path
                    d="M352 64C352 46.3 337.7 32 320 32C302.3 32 288 46.3 288 64L288 320C288 337.7 302.3 352 320 352C337.7 352 352 337.7 352 320L352 64zM210.3 162.4C224.8 152.3 228.3 132.3 218.2 117.8C208.1 103.3 188.1 99.8 173.6 109.9C107.4 156.1 64 233 64 320C64 461.4 178.6 576 320 576C461.4 576 576 461.4 576 320C576 233 532.6 156.1 466.3 109.9C451.8 99.8 431.9 103.3 421.7 117.8C411.5 132.3 415.1 152.2 429.6 162.4C479.4 197.2 511.9 254.8 511.9 320C511.9 426 425.9 512 319.9 512C213.9 512 128 426 128 320C128 254.8 160.5 197.1 210.3 162.4z"
                  />
                </svg>
              </button>
            </form>
            <%}%>
          </div>
        </nav>
      </header>
    </div>
    <div class="main-wrapper">
      <main>
        <h1>Messages</h1>
        <% if(locals.currentUser){ %>
        <form class="open-message-dialog">
          <div class="errors-container">
            <p class="server-error"></p>
          </div>
          <button type="button" class="open-dialog-button">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
              <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
              <path
                d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z"
              />
            </svg>
          </button>
        </form>
        <% }%>
        <% if(locals.messages?.length!=0){%>
        <div class="messages-container">
          <% if(locals.failedFetch){%>
          <div class="errors-container">
            <p>
              We couldn't load the messages right now, please try again later.
            </p>
          </div>
          <%}%>
          <% messages.forEach(message=>{%>
          <div class="message-card">
            <%if (locals.failedDeletion && locals.failedDeleteMessageId ===
            message.id){%>
            <div class="errors-container">
              <p>
                We couldn't delete the message right now, please try again
                later.
              </p>
            </div>
            <%}%>
            <div class="message-data-container title-container">
              <p>Title</p>
              <p><%= message.title %></p>
            </div>
            <div class="message-data-container text-container">
              <p>Text</p>
              <p><%= message.text %></p>
            </div>
            <%if(locals.currentUser?.ismember || locals.currentUser?.isadmin){%>
            <div class="message-data-container username-container">
              <p>Username</p>
              <%= locals.currentUser.username %>
            </div>
            <div class="message-data-container timestamp-container">
              <p>Timestamp</p>
              <p><%= message.timestamp %></p>
            </div>
            <%}%>
            <% if(locals.currentUser?.isadmin){%>
            <div class="message-data-container">
              <form action="/message/delete/<%= message.id %>" method="post">
                <button type="submit">Delete</button>
              </form>
            </div>
            <%}%>
          </div>
          <%})%>
        </div>
        <%}else{%>
        <h2 class="empty-content-placeholder">No messages added yet...</h2>
        <%}%>
        <dialog>
          <form class="message-form" method="post" action="/">
            <h3>Add message</h3>
            <div class="errors-container"></div>
            <label for="title">Title<input id="title" name="title" /></label>
            <label for="text"
              >Text<textarea id="text" name="text"></textarea>
            </label>
            <div class="button-container">
              <button class="cancel-button" type="button">Cancel</button>
              <button class="add-button" type="submit">Add</button>
            </div>
          </form>
        </dialog>
      </main>
    </div>
    <div class="footer-wrapper"><%- include("partials/footer") %></div>
  </body>
</html>
